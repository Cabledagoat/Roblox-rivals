local function destroyVisual(p)
    local v = visuals[p]
    if not v then return end
    v.frame:Destroy()
    v.highlight:Destroy()
    visuals[p] = nil
end
local function unload()
    if not active then return end
    active = false
    RunService:UnbindFromRenderStep(bindName)
    for _, conn in ipairs(connections) do conn:Disconnect() end
    for p in pairs(visuals) do destroyVisual(p) end
    gui:Destroy()
    if env.PrivateClientTest and env.PrivateClientTest.Unload == unload then
        env.PrivateClientTest = nil
    end
end
env.PrivateClientTest = {Config = Config, Unload = unload}
