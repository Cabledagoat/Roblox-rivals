local function numberInput(key, label, minimum, maximum)
    local labelRow = row("TextLabel", label, 20)
    labelRow.BackgroundTransparency = 1
    local input = row("TextBox", tostring(Config[key]), 26)
    input.ClearTextOnFocus = false
    connect(input.FocusLost, function()
        local value = tonumber(input.Text)
        if value and value == value then
            Config[key] = math.clamp(value, minimum, maximum)
        end
        input.Text = tostring(Config[key])
    end)
end
